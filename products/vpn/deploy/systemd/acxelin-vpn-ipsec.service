[Unit]
Description=Acxelin VPN site-to-site IPsec: strongSwan with ML-KEM, its PSK and PPK agreed over ML-DSA mutual TLS
After=network-online.target strongswan-pqc.service
Wants=network-online.target
Requires=strongswan-pqc.service
ConditionPathExists=/etc/acxelin-vpn/site.toml

[Service]
ExecStart=/opt/acxelin-vpn/bin/acxelin-vpn up --config /etc/acxelin-vpn/site.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
