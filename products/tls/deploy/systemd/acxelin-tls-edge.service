[Unit]
Description=acxelin-tls edge: post-quantum TLS in front of local services
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/acxelin-tls/edge.toml

[Service]
User=acxelin
ExecStart=/opt/acxelin-tls/bin/acxelin-tls edge --config /etc/acxelin-tls/edge.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
StateDirectory=acxelin-tls/edge
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
