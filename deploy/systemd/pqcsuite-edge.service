[Unit]
Description=pqcsuite edge: post-quantum TLS in front of local services
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/pqcsuite/edge.toml

[Service]
User=pqc
ExecStart=/opt/pqcsuite/bin/pqcsuite tls edge --config /etc/pqcsuite/edge.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
StateDirectory=pqcsuite/edge
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
