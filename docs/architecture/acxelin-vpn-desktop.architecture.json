  "cards": [
    {
      "dot": "emerald",
      "title": "Least privilege",
      "items": [
        "Tray and window run as you; only the VPN service gets administrator rights",
        "Closing the window leaves the VPN up; Quit stops the service",
        "Start at login shows the tray only, with no prompt"
      ]
    },
    {
      "dot": "rose",
      "title": "Loopback API",
      "items": [
        "127.0.0.1 only, its own Host and Origin",
        "Browser addresses carry a one-time ticket, never the session key",
        "Wrong keys are rate-limited"
      ]
    },
    {
      "dot": "violet",
      "title": "Post-quantum keys",
      "items": [
        "Hybrid ML-KEM key exchange, ML-DSA certificates",
        "PSK exported from the TLS session, renewed every rotation",
        "WireGuard's own handshake stays classical"
      ]
    }
  ]
